{
  "name": "@audio/reverb",
  "version": "1.3.0",
  "type": "module",
  "sideEffects": false,
  "description": "Plate, spring, convolution reverb",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./members/*.d.ts",
      "default": "./members/*.js"
    }
  },
  "files": [
    "index.js",
    "*.d.ts",
    "members/"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node test.js",
    "test:all": "npm test --workspaces --if-present && npm test",
    "publish:all": "node ../compile/tools/tested.js && npm publish --workspaces && npm publish",
    "members": "node scripts/members.js",
    "prepublishOnly": "node ../compile/tools/tested.js && node scripts/members.js --check"
  },
  "dependencies": {
    "@audio/reverb-schroeder": "^1.2.0",
    "@audio/reverb-freeverb": "^1.1.0",
    "@audio/reverb-dattorro": "^1.2.0",
    "@audio/reverb-convolution": "^1.2.0",
    "@audio/reverb-fdn": "^1.2.0",
    "@audio/reverb-spring": "^1.2.0",
    "@audio/reverb-shimmer": "^1.2.0"
  },
  "keywords": [
    "audio",
    "dsp",
    "reverb",
    "schroeder",
    "freeverb",
    "dattorro",
    "plate",
    "fdn",
    "convolution",
    "spring",
    "shimmer",
    "reverberation"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/reverb.git"
  },
  "funding": "https://github.com/sponsors/audiojs",
  "types": "./index.d.ts"
}
